      <name>Enlace S2-B</name>
      <styleUrl>#lineaAcceso</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>-90.803970,14.216939,30 -90.790400,14.201000,12</coordinates>
      </LineString>
    </Placemark>
    <Placemark>
